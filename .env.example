# =============================================================================
# D1 Ecosystem — variables de entorno (Supabase + Resend)
# Nombres exactos según el código fuente. Copia a .env y completa valores.
# =============================================================================

# --- Supabase Postgres (Prisma) ---
# prisma/schema.prisma → datasource.url
# Pooler de transacciones (puerto 6543). Runtime de la app / Prisma Client.
# Recomendado: ?pgbouncer=true (y en serverless a menudo &connection_limit=1)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# prisma/schema.prisma → datasource.directUrl
# Pooler de sesión / conexión directa (puerto 5432). Migraciones, db push, introspect.
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# --- Supabase Storage (src/lib/storage.ts) ---
# URL del proyecto. createClient(url, serviceRoleKey) para uploads y signed URLs.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Service role key (solo servidor). Nunca exponer al cliente.
# Autoriza list/create bucket, upload y createSignedUrl.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Nombre del bucket (opcional; default en código: "d1-documents").
# Usado en getBucket(), uploadObject() y getPresignedDownloadUrl().
SUPABASE_STORAGE_BUCKET=d1-documents

# --- Resend (src/lib/email.ts) ---
# API key. Obligatoria: sin ella sendEmail() lanza RESEND_API_KEY is not configured.
RESEND_API_KEY=re_xxxxxxxx

# Remitente de emails.send({ from, ... }).
# Opcional en código (fallback: "D1 Ecosystem <onboarding@resend.dev>").
# En producción debe ser un dominio verificado en Resend.
EMAIL_FROM="D1 Ecosystem <onboarding@resend.dev>"
